# Copy this file to .env and fill in real values. .env is gitignored.

# Anthropic API key — extraction will fail with a clear error until this is set.
ANTHROPIC_API_KEY=

# Which Claude model runs extraction.
FORGE_EXTRACTION_MODEL=claude-sonnet-5

# Neo4j — matches docker-compose.yml. Bolt port is offset from Neo4j's default
# (7688, not 7687) so this can run alongside the older qmat-neo4j container.
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=forge-dev-password

# Where uploaded solicitation documents are stored on disk.
FORGE_STORAGE_DIR=./storage
